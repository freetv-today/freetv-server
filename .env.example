# MariaDB connection used by the PHP backend
DB_HOST=127.0.0.1
DB_NAME=freetv
DB_USER=freetv
DB_PASS=

# PHP/server runtime filesystem configuration.
# Relative to the private application root containing .env, vendor/, and temp/
FREETV_PUBLIC_PATH=public

# Typical shared-hosting mapping when the web root is named public_html:
# FREETV_PUBLIC_PATH=public_html

# FREETV_PUBLIC_PATH is a filesystem path. It is distinct from VITE_BASE_PATH,
# which is a browser URL path used by the frontend build

# PHP/server runtime metadata for the currently published remote First Run ZIPs
# URLs must use HTTPS. SHA values cover the complete ZIP archives
# These are runtime values, distinct from Vite frontend build configuration
FREETV_SAMPLE_DATA_URL=https://downloads.example.com/freetv-sample-data.zip
FREETV_SAMPLE_DATA_SHA256=<64-lowercase-hex-sha256>
FREETV_OFFICIAL_DATA_URL=https://downloads.example.com/freetv-official-data.zip
FREETV_OFFICIAL_DATA_SHA256=<64-lowercase-hex-sha256>

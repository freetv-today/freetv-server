# PHP/server runtime filesystem configuration.
# Relative to the private application root containing .env, vendor/, and temp/.
FREETV_PUBLIC_PATH=public

# Typical shared-hosting mapping when the web root is named public_html:
# FREETV_PUBLIC_PATH=public_html

# FREETV_PUBLIC_PATH is a filesystem path. It is distinct from VITE_BASE_PATH,
# which is a browser URL path used by the frontend build.

{
	"name": "freetv-admin",
	"version": "3.0.3-beta",
	"description": "Administration tools for managing a collection of shows and movies for FreeTV.",
	"author": "Ken Dawson",
	"license": "GPL-3.0-only",
	"homepage": "https://freetv.today",
	"repository": "https://github.com/freetv-today/freetv-admin",
	"bugs": "https://github.com/freetv-today/freetv-admin/issues",
	"private": false,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && npm run validate:dist",
		"validate:dist": "node scripts/validate-admin-dist.js",
		"test": "node --test tests/regression/api/*.test.js",
		"test:db:check": "php tests/regression/support/database-preflight.php",
		"test:db:install": "php tests/regression/support/database-install.php",
		"test:db:clean": "php tests/regression/support/database-clean.php",
		"test:admin-dist": "node tests/AdminDistContractTest.js",
		"test:data-snapshot-nav": "node --test tests/DataSnapshotNavigationFlagTest.js",
		"preview": "vite preview"
	},
	"dependencies": {
		"@eslint/js": "^9.34.0",
		"@preact/signals": "^2.3.1",
		"bootstrap": "^5.3.8",
		"preact": "^10.25.3",
		"preact-iso": "^2.12.2"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.9.3",
		"eslint": "^9.34.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"vite": "^6.0.4"
	},
	"engines": {
		"node": ">=22"
	},
	"allowScripts": {
		"esbuild@0.25.8": true
	}
}
